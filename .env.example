# ==============================================================================================
# Copy to .env and fill in. .env is gitignored — never commit real tokens.
#
#   cp .env.example .env
#   docker compose up -d
# ==============================================================================================

# ---- Telegram ---------------------------------------------------------------------------------
# Bot token from @BotFather. Chat id from @userinfobot, or from
# https://api.telegram.org/bot<TOKEN>/getUpdates after sending your bot a message.
# Leave TELEGRAM_ENABLED=false to collect prices without notifications.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Database ---------------------------------------------------------------------------------
# Required by docker compose. Choose something long; it is never used interactively.
DATABASE_NAME=flightmonitor
DATABASE_USER=flightmonitor
DATABASE_PASSWORD=

# ---- Providers --------------------------------------------------------------------------------
# SerpApi (Google Flights) — https://serpapi.com/users/sign_up
# The primary source: the only free self-serve option in 2026 that returns full itineraries with
# named connecting airports, which is what makes the blocked-country rule enforceable.
# NOTE: one round-trip search costs TWO API calls (the return legs need a second request).
#
# The free plan was measured at 250 searches/month (GET https://serpapi.com/account reports your
# real figure without spending one). 230 leaves ~20 calls of headroom for manual triggers and
# retries. The budget is released evenly across the month, so a schedule that would
# slightly overrun simply has the occasional run skipped instead of hitting a hard wall mid-month.
SERPAPI_ENABLED=true
SERPAPI_KEY=
SERPAPI_MAX_CALLS_PER_MONTH=230
SERPAPI_MAX_QUERIES_PER_RUN=2
SERPAPI_MAX_OPTIONS=1

# Travelpayouts (Aviasales cache) — https://www.travelpayouts.com/
# Free and effectively unmetered, but it never names the connecting airports, so its offers are
# ROUTE_UNVERIFIABLE and are rejected by default. They still feed the price history.
TRAVELPAYOUTS_ENABLED=true
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MAX_QUERIES_PER_RUN=12

# Local fixture replay — SIMULATED DATA, NOT REAL PRICES.
# Only for trying the pipeline without any API key. Every alert it produces is banner-flagged.
FIXTURE_ENABLED=false

# ---- Trip -------------------------------------------------------------------------------------
# The trips themselves (Tokyo multi-city, Rio -> POA on 13/01, POA -> Rio) are defined in
# src/main/resources/application.yml. Override one only when needed, e.g. TOKYO_MAX_PRICE_GBP=2000,
# TOKYO_DOMESTIC_MAX_PRICE=350 or RIO_TARGET_MAX_PRICE=800.

ADULTS=1
CABIN_CLASS=ECONOMY

# ---- Second trip: Porto Alegre -> Rio de Janeiro --------------------------------------------------
# Defaults live in application.yml (that is what GitHub Actions uses). Uncomment only to override
# locally. Times are local to the departure airport; the budget is in reais.
# RIO_ENABLED=true
# RIO_DESTINATION_AIRPORTS=GIG,SDU
# RIO_DEPARTURE_DATE=2027-01-11
# RIO_RETURN_DATE=2027-01-13
# RIO_LATEST_RETURN_ARRIVAL=2027-01-13T23:59:00-03:00
# RIO_TARGET_MIN_PRICE=650
# RIO_TARGET_MAX_PRICE=800
# RIO_OUTBOUND_FROM=00:00
# RIO_OUTBOUND_TO=11:59
# RIO_OUTBOUND_PREFERRED=05:00
# RIO_RETURN_PREFERRED=11:00

# ---- Routing preference -----------------------------------------------------------------------
# THIS IS A PERSONAL PREFERENCE, NOT A RISK ASSESSMENT. The system makes no judgement of its own
# about which places are safe; it only rejects what is listed here. Origin, destination and EVERY
# connecting airport are checked, in both directions.
# ISO 3166-1 alpha-2 country codes.
BLOCKED_COUNTRIES=QA,AE,SA,KW,BH,OM,JO,LB,SY,IQ,YE,EG,LY,SD,DZ,TN,MA
# Individual airports to reject regardless of country, e.g. DOH,DXB
BLOCKED_AIRPORTS=
# Fail closed on offers whose connections were never disclosed by the source.
REJECT_UNVERIFIABLE_ROUTES=true
# Fail closed on airports missing from airports.csv (their country cannot be checked).
REJECT_UNKNOWN_AIRPORTS=true

# ---- Alerts -----------------------------------------------------------------------------------
MIN_PRICE_DROP_GBP=30
MIN_PRICE_DROP_PERCENT=3
ALERT_COOLDOWN_HOURS=12
NOTIFY_ABOVE_BUDGET=false
NOTIFY_FIRST_SIGHTING=true
MAX_ALERTS_PER_RUN=5
# Aeroporto fora de PRIMARY_DESTINATIONS so vira alerta se economizar pelo menos isto em relacao
# ao melhor preco conhecido no destino principal. Sao Paulo (GRU) fica a ~1h de voo ou 18h de onibus
# de Porto Alegre, entao "um pouco mais barato" nao compensa o transtorno.
ALTERNATIVE_DESTINATION_MIN_SAVING_GBP=200

# ---- Scheduling -------------------------------------------------------------------------------
SEARCH_ENABLED=true
SEARCH_INTERVAL_HOURS=24
MAX_QUERIES_PER_RUN=12
RUN_ON_STARTUP=false

# ---- Ranking weights (normalised components, so these are directly comparable) ------------------
SCORE_PRICE_WEIGHT=45
SCORE_DURATION_WEIGHT=25
SCORE_STOPS_WEIGHT=15
SCORE_BAGGAGE_WEIGHT=5
SCORE_DATE_WEIGHT=10

# ---- Misc -------------------------------------------------------------------------------------
# Running locally: the port the app listens on.
# Running with docker compose: the HOST port to publish on. Inside the container the app is always
# on 8080, so the healthcheck and the port mapping cannot drift apart.
SERVER_PORT=8080
LOG_LEVEL=INFO
TZ=UTC
FX_API_URL=https://api.frankfurter.dev/v1
FX_CACHE_TTL_MINUTES=360
